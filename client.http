@apiURL = http://localhost:9080

### ============================================================
### CREATE PRODUCT
### ============================================================

### Create Product - Success
# @name createProduct
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17",
  "price": 999
}


### Create Product - Error: Empty Name
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "",
  "price": 999
}


### Create Product - Error: Negative Price
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17",
  "price": -1
}


### Create Product - Error: Missing Name
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "price": 999
}


### Create Product - Error: Missing Price
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17"
}


### Create Product - Error: Zero Price
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17",
  "price": 0
}


### Create Product - Error: Name Only Whitespace
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "   ",
  "price": 999
}


### Create Product - Error: Invalid Name Type
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": 123,
  "price": 999
}


### Create Product - Error: Invalid Price Type
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17",
  "price": "999"
}


### Create Product - Error: Null Price
POST {{apiURL}}/api/products HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17",
  "price": null
}


### ============================================================
### GET PRODUCT
### ============================================================

### Get Product - Success
GET {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1


### Get Product - Not Found
GET {{apiURL}}/api/products/no-exists HTTP/1.1


### Get Product - Invalid ID
GET {{apiURL}}/api/products/invalid-id HTTP/1.1


### ============================================================
### GET PRODUCTS
### ============================================================

### Get List Products - Success
GET {{apiURL}}/api/products HTTP/1.1

### Get List Products by search - Success
GET {{apiURL}}/api/products?search=iphone HTTP/1.1


### ============================================================
### UPDATE PRODUCT
### ============================================================

### Update Product - Success
PUT {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17 Pro",
  "price": 1299,
  "version": 1
}


### Verify Updated Product
GET {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1


### Update Product - Error: Empty Name
PUT {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1
content-type: application/json

{
  "name": "",
  "price": 1299,
  "version": 1
}


### Update Product - Error: Negative Price
PUT {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17 Pro",
  "price": -1
}


### Update Product - Not Found
PUT {{apiURL}}/api/products/no-exists HTTP/1.1
content-type: application/json

{
  "name": "iPhone 17 Pro",
  "price": 1299
}


### ============================================================
### DELETE PRODUCT
### ============================================================

### Delete Product - Success
DELETE {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1


### Verify Deleted Product
GET {{apiURL}}/api/products/{{createProduct.response.body.id}} HTTP/1.1


### Delete Product - Not Found
DELETE {{apiURL}}/api/products/no-exists HTTP/1.1
